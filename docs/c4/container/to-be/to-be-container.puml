@startuml

title To-Be Cinema Abyss Container Diagram

top to bottom direction

!include ../../c4-local/C4-Container.puml

Person(user, "Пользователь", "Пользователь Cinema Abyss")

System_Ext(PaymentSystem, "Платёжная система", "Внешняя система обработки платежей")
System_Ext(OnlineCinemas, "Онлайн-кинотеатры", "Внешние поставщики контента")
System_Ext(S3, "S3", "Внешнее объектное хранилище контента")

Container_Boundary(CinemaAbyss, "Cinema Abyss") {

    Container(SmartTV, "Smart TV", "JavaScript", "Приложение для Smart TV")
    Container(WebApp, "Web-приложение", "Next.js", "Web-интерфейс Cinema Abyss")
    Container(MobileApp, "Mobile-приложение", "Swift / Kotlin", "Приложение для iOS и Android")

    Container(ProxyService, "Proxy Service", "Go", "Принимает, проверяет и маршрутизирует запросы")

    Container(UserService, "Users Service", "Go", "Управляет регистрацией, аутентификацией и пользовательскими данными")
    ContainerDb(UserDb, "Users DB", "PostgreSQL", "Хранит данные пользователей")

    Container(MoviesService, "Movies Service", "Go", "Управляет метаданными фильмов, рейтингами и жанрами")
    ContainerDb(MoviesDb, "Movies DB", "PostgreSQL", "Хранит метаданные фильмов, рейтинги и жанры")

    Container(PaymentService, "Payments Service", "Go", "Управляет платежами, статусами операций и возвратами")
    ContainerDb(PaymentDb, "Payments DB", "PostgreSQL", "Хранит платежи статусы операций и возвраты")

    Container(SubscriptionService, "Subscriptions Service", "Go", "Управляет подписками пользователей и тарифными планами")
    ContainerDb(SubscriptionDb, "Subscriptions DB", "PostgreSQL", "Хранит подписки и тарифные планы")

    Container(EventsService, "Events Service", "Node.js / Express", "Принимает события через API, публикует их в Kafka и обрабатывает как consumer")
    ContainerQueue(EventBroker, "Event Broker", "Kafka", "Обеспечивает асинхронное взаимодействие")

    Container(RecommendationService, "Recommendation Integration Service", "Go", "Интегрируется с внешней рекомендательной системой")
}

Boundary(RecommenderBoundary, "Внешняя рекомендательная система") {
    ContainerQueue_Ext(RecommendationQueue, "Очередь рекомендаций", "RabbitMQ", "Асинхронный обмен данными между Cinema Abyss и рекомендательной системой")
}

Rel(user, SmartTV, "")
Rel(user, WebApp, "Использует")
Rel(user, MobileApp, "")

Rel(SmartTV, ProxyService, "", "HTTPS / REST")
Rel(WebApp, ProxyService, "Отправляет запросы", "HTTPS / REST")
Rel(MobileApp, ProxyService, "", "HTTPS / REST")

Rel(ProxyService, UserService, "", "HTTPS / REST")
Rel(ProxyService, MoviesService, "", "HTTPS / REST")
Rel(ProxyService, PaymentService, "Маршрутизирует запросы платежей", "HTTPS / REST")
Rel(ProxyService, SubscriptionService, "Маршрутизирует запросы подписок", "HTTPS / REST")
Rel(ProxyService, RecommendationService, "", "HTTPS / REST")

Rel(UserService, UserDb, "Читает и сохраняет данные", "SQL")
Rel(MoviesService, MoviesDb, "Читает и сохраняет данные", "SQL")
Rel(PaymentService, PaymentDb, "Читает и сохраняет данные", "SQL")
Rel(SubscriptionService, SubscriptionDb, "Читает и сохраняет данные", "SQL")

Rel(UserService, EventsService, "Передаёт события пользователей", "HTTPS / REST")
Rel(MoviesService, EventsService, "Передаёт события фильмов", "HTTPS / REST")
Rel(PaymentService, EventsService, "Передаёт события платежей", "HTTPS / REST")

Rel(EventsService, EventBroker, "Публикует и получает события", "Kafka")

Rel(PaymentService, PaymentSystem, "Проводит платежи", "HTTPS / API")

Rel(MoviesService, OnlineCinemas, "Получает данные о контенте", "HTTPS / API")
Rel(MoviesService, S3, "Хранит и получает контент", "S3 API")

Rel(RecommendationService, RecommendationQueue, "Передаёт данные и получает рекомендации", "API")

@enduml

